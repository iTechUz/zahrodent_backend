# Server & Environment
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
TZ=Asia/Tashkent
# Required in production (comma-separated). Also used by the Socket.IO gateway.
CORS_ORIGINS=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:3000

# Database (Prisma)
# Local: postgresql://postgres:postgres@localhost:5432/zahro_dental?schema=public
# Docker: postgresql://postgres:postgres@db:5432/zahro_dental?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zahro_dental?schema=public

# Authentication
# Production: required, at least 32 random characters (e.g. `openssl rand -base64 48`),
# otherwise the server refuses to start.
JWT_SECRET=generate-a-secure-random-string
JWT_EXPIRES_IN=7d

# Initial admin (created on boot only when there is no admin user).
# Production: INITIAL_ADMIN_PASSWORD is required (min 8 chars, not "admin123").
INITIAL_ADMIN_PHONE="+998901234567"
INITIAL_ADMIN_PASSWORD=strong_password
INITIAL_ADMIN_NAME="Admin"

# SMS Service (Eskiz.uz). Empty → no SMS is sent; reminders are recorded as
# "failed" and bookings are NOT marked as reminded.
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546
# Optional: Eskiz HTTP timeout in ms (default 8000)
ESKIZ_HTTP_TIMEOUT_MS=8000

# Swagger UI at /swagger. Default: on in development, off in production.
# Set to true only if you really need docs on a production server.
SWAGGER_ENABLED=false

# Telegram lead bot (long polling inside the API process).
# Empty token → bot disabled.
TELEGRAM_BOT_TOKEN=
# Set to false on every instance except ONE when running several API
# replicas/containers with the same token (two pollers → Telegram 409 Conflict).
# Default: true.
TELEGRAM_BOT_ENABLED=true

# 1 when running behind nginx / a load balancer (correct client IPs for
# rate limiting). 0 when the API is exposed directly.
TRUST_PROXY=1
