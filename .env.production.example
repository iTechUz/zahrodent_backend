# ─────────────────────────────────────────────────────────────────────────────
# Zahro Dental API — PRODUCTION (server) uchun namuna.
# Serverdagi joyi: /home/ubuntu/projects/zaxro_dent/backend/zahrodent_backend/.env
# (chmod 600, egasi ubuntu). Haqiqiy faylni hech qachon git'ga qo'shmang.
# Hamma CHANGE_ME ni almashtiring. Maxfiy kalit yaratish:  openssl rand -base64 48
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
# Backend porti. Docker image'da PORT=7878 va TZ=Asia/Tashkent qo'yilgan — shularga mos qoldiring.
PORT=7878
# Tinglash manzili. 0.0.0.0 = konteyner tashqarisidan ham kirish mumkin.
HOST=0.0.0.0
# Production rejimi: qat'iy tekshiruvlar yoqiladi.
NODE_ENV=production
# Vaqt zonasi (eslatmalar shu bo'yicha ketadi). O'zgartirmang.
TZ=Asia/Tashkent
# MAJBURIY — bo'sh yoki noto'g'ri bo'lsa backend ishga tushmaydi (502 xatosining tez-tez uchraydigan sababi).
# Admin panel va frontend manzillari, vergul bilan, oxirida "/" yo'q.
# Masalan: https://admin.zaxrodenta.uz,https://zaxrodenta.uz
CORS_ORIGINS=https://admin.CHANGE_ME.uz
# Backend'ning ochiq manzili (log va havolalar uchun).
PUBLIC_BASE_URL=https://api.CHANGE_ME.uz
# Backend nginx orqasida turadi, shuning uchun 1 (foydalanuvchining haqiqiy IP'si uchun).
TRUST_PROXY=1
# Swagger (API hujjati) production'da o'chiq tursin, juda zarur bo'lmasa.
SWAGGER_ENABLED=false
# Log formati: json (log yig'uvchi tizimlar uchun, production'da odatiy).
LOG_FORMAT=json

# ── Baza ─────────────────────────────────────────────────────────────────────
# PostgreSQL manzili. Baza zaxro_network Docker tarmog'ida, shuning uchun HOST — konteyner nomi (zahro_db).
# Parol yaratish (URL uchun xavfsiz):  openssl rand -base64 32 | tr -d '/+='
DATABASE_URL=postgresql://zahro:CHANGE_ME@zahro_db:5432/zahro_dental?schema=public

# ── Autentifikatsiya ─────────────────────────────────────────────────────────
# MAJBURIY, kamida 32 belgi:  openssl rand -base64 48
# Almashtirsangiz hamma foydalanuvchi tizimdan chiqib ketadi.
JWT_SECRET=CHANGE_ME
# Access token umri (15m = 15 daqiqa). Odatda o'zgartirmaysiz.
JWT_EXPIRES_IN=15m
# Refresh token umri, kunlarda (30 = bir oy).
REFRESH_TOKEN_TTL_DAYS=30

# ── Birinchi admin (faqat bazada admin yo'q bo'lganda yaratiladi) ────────────
# Admin telefoni (login shu), xalqaro formatda: "+998901234567".
INITIAL_ADMIN_PHONE="+998CHANGE_ME"
# MAJBURIY: kamida 8 belgi, "admin123" bo'lmasin. Production'da har ishga tushganda
# tekshiriladi — admin allaqachon bor bo'lsa ham bo'sh qolsa backend ishga tushmaydi.
# Faqat birinchi adminni yaratadi: birinchi kirishdan keyin parolni panel ichidan
# (PATCH /auth/password) almashtiring; bu yerdagi keyingi o'zgarishlar mavjud adminga ta'sir qilmaydi.
INITIAL_ADMIN_PASSWORD=CHANGE_ME
# Admin ismi (panelda ko'rinadi).
INITIAL_ADMIN_NAME="Admin"

# ── SMS (Eskiz.uz) ───────────────────────────────────────────────────────────
# Eskiz kabinetidagi login (email).
ESKIZ_EMAIL=CHANGE_ME@example.com
# Eskiz kabinetidagi parol / maxfiy kalit.
ESKIZ_PASSWORD=CHANGE_ME
# Eskiz'da tasdiqlangan yuboruvchi nomi yoki raqami.
ESKIZ_FROM=4546
# Eskiz API manzili. Odatda o'zgartirmaysiz.
ESKIZ_BASE_URL=https://notify.eskiz.uz
# Eskiz javobini kutish vaqti, millisekundda (8000 = 8 soniya).
ESKIZ_HTTP_TIMEOUT_MS=8000

# ── Telegram bot ─────────────────────────────────────────────────────────────
# @BotFather bergan token. Bu token bilan FAQAT BITTA ishlayotgan nusxa bo'lsin
# (lokal kompyuterda ham ishlatmang), aks holda 409 Conflict chiqadi.
TELEGRAM_BOT_TOKEN=CHANGE_ME
# Botni yoqish (true) yoki o'chirish (false). Bir tokenni bir necha server ishlatsa, bittasida true qoldiring.
TELEGRAM_BOT_ENABLED=true
# Klinika xodimlari guruhining chat ID'si (manfiy son, masalan -1001234567890).
# Saytdan/botdan kelgan yangi lidlar shu guruhga tushadi. Bo'sh bo'lsa o'chiq.
# Guruhda FAQAT klinika xodimlari bo'lsin (bemor ismi va telefoni yuboriladi).
TELEGRAM_LEADS_CHAT_ID=
# Botning ochiq username'i, "@" belgisiz. SMS ichidagi t.me/<username>?start=lead havolasi uchun.
TELEGRAM_BOT_USERNAME=
# Ixtiyoriy: bron holati o'zgarishi va ko'chirish so'rovlari tushadigan guruh ID'si.
# Bo'sh bo'lsa TELEGRAM_LEADS_CHAT_ID ishlatiladi.
TELEGRAM_STATUS_CHAT_ID=
