# ─────────────────────────────────────────────────────────────────────────────
# Zahro Dental API — LOCAL DEVELOPMENT defaults.
# Copy: cp .env.example .env   (production: see .env.production.example)
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
TZ=Asia/Tashkent
# Comma-separated. Required in production. Also used by the Socket.IO gateway.
# Empty in development → every origin is allowed.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# Only used in the startup banner / Swagger links.
PUBLIC_BASE_URL=http://localhost:3000
# 1 behind nginx / a load balancer (real client IP for rate limiting), 0 otherwise.
TRUST_PROXY=0
# Swagger UI at /swagger. Default: on in development, off in production.
SWAGGER_ENABLED=true
# text | json. Default: json when NODE_ENV=production, text otherwise.
LOG_FORMAT=text

# ── Database (Prisma / PostgreSQL) ───────────────────────────────────────────
# Local:  postgresql://postgres:postgres@localhost:5432/zahro_dental?schema=public
# Docker: postgresql://postgres:postgres@db:5432/zahro_dental?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zahro_dental?schema=public

# ── Auth ─────────────────────────────────────────────────────────────────────
# Production: required, >= 32 random chars (openssl rand -base64 48).
JWT_SECRET=dev-only-change-me-to-a-long-random-string
# Access token lifetime: 900 | 30s | 15m | 1h | 7d. Default 15m.
JWT_EXPIRES_IN=15m
# Refresh token lifetime in days (1..365). Default 30.
REFRESH_TOKEN_TTL_DAYS=30

# ── Initial admin (created on boot only when no admin user exists) ───────────
# Production: INITIAL_ADMIN_PASSWORD required (>= 8 chars, not "admin123").
INITIAL_ADMIN_PHONE="+998901234567"
INITIAL_ADMIN_PASSWORD=admin12345
INITIAL_ADMIN_NAME="Admin"

# ── SMS (Eskiz.uz) ───────────────────────────────────────────────────────────
# Empty → no SMS is sent; reminders are recorded as "failed" and bookings are
# NOT marked as reminded (retried on the next run).
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546
# Optional overrides
ESKIZ_BASE_URL=https://notify.eskiz.uz
ESKIZ_HTTP_TIMEOUT_MS=8000

# ── Telegram bot (leads + patient reminders; long polling in the API process) ─
# Empty token → bot disabled. Use a separate TEST bot locally — two pollers on
# the production token → Telegram 409 Conflict.
TELEGRAM_BOT_TOKEN=
# false on every API instance except ONE when several share the same token.
TELEGRAM_BOT_ENABLED=true
