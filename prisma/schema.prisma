generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  phone        String   @unique
  passwordHash String   @map("password_hash")
  role         String
  specialty    String?
  avatar       String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  doctor        Doctor?
  comments      PatientComment[]
  refreshTokens RefreshToken[]

  @@map("users")
}

/// Refresh tokens (rotating). Only the sha256 hash of the token is stored.
model RefreshToken {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  tokenHash    String    @unique @map("token_hash")
  familyId     String    @map("family_id")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  replacedById String?   @map("replaced_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  userAgent    String?   @map("user_agent")
  ip           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Patient {
  id             String    @id @default(cuid())
  firstName      String    @map("first_name")
  lastName       String    @map("last_name")
  age            Int
  phone          String
  address        String    @default("")
  workplace      String    @default("")
  source         String
  notes          String    @default("")
  avatar         String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Date
  toothChart     Json?     @map("tooth_chart")
  /// Soft delete: set → hidden from every patient list/lookup.
  deletedAt      DateTime? @map("deleted_at")
  /// Telegram chat id (bigint as string) — reminders go via the bot when set.
  telegramChatId String?   @map("telegram_chat_id")

  assignedDoctorId String? @map("assigned_doctor_id")
  assignedDoctor   Doctor? @relation("AssignedDoctor", fields: [assignedDoctorId], references: [id])

  bookings      Booking[]
  visits        Visit[]
  payments      Payment[]
  notifications Notification[]
  comments      PatientComment[]
  prescriptions Prescription[]

  @@index([createdAt])
  @@index([phone])
  @@index([lastName, firstName])
  @@index([assignedDoctorId])
  @@index([deletedAt])
  @@map("patients")
}

model Doctor {
  id        String  @id @default(cuid())
  firstName String  @default("") @map("first_name")
  lastName  String  @default("") @map("last_name")
  specialty String
  phone     String
  avatar    String?
  schedule  Json?
  daysOff   Json?   @map("days_off")

  bookings      Booking[]
  visits        Visit[]
  prescriptions Prescription[]
  notifications Notification[]
  user          User?          @relation(fields: [userId], references: [id])
  userId        String?        @unique @map("user_id")

  assignedPatients Patient[] @relation("AssignedDoctor")

  @@map("doctors")
}

model Service {
  id          String  @id @default(cuid())
  name        String
  category    String
  price       Int
  duration    Int
  description String?

  bookings Booking[]
  payments Payment[]

  @@map("services")
}

model Booking {
  id                    String    @id @default(cuid())
  patientId             String    @map("patient_id")
  doctorId              String    @map("doctor_id")
  date                  DateTime  @db.Date
  time                  String
  source                String
  status                String
  notes                 String    @default("")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Date
  serviceId             String?   @map("service_id")
  reminderSentAt        DateTime? @map("reminder_sent_at")
  /// Patient's 1..5 rating from the Telegram "completed" message.
  feedbackRating        Int?      @map("feedback_rating")
  feedbackAt            DateTime? @map("feedback_at")
  /// Scheduled Telegram reminders (24h / 2h before) and the patient's answers.
  reminder24SentAt      DateTime? @map("reminder_24_sent_at")
  reminder2SentAt       DateTime? @map("reminder_2_sent_at")
  patientConfirmedAt    DateTime? @map("patient_confirmed_at")
  rescheduleRequestedAt DateTime? @map("reschedule_requested_at")

  patient Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor  Doctor   @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  visits     Visit[]
  statusLogs BookingStatusLog[]

  @@index([patientId])
  @@index([doctorId])
  @@index([date])
  @@index([status])
  @@index([date, status])
  @@index([doctorId, date])
  @@map("bookings")
}

/// Who changed a booking's status, when, and why (cancel reason).
model BookingStatusLog {
  id            String   @id @default(cuid())
  bookingId     String   @map("booking_id")
  fromStatus    String   @map("from_status")
  toStatus      String   @map("to_status")
  reason        String?
  changedById   String?  @map("changed_by_id")
  /// Snapshot, so the log stays readable if the user is renamed/deleted.
  changedByName String   @map("changed_by_name")
  createdAt     DateTime @default(now()) @map("created_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
  @@map("booking_status_logs")
}

model Visit {
  id        String   @id @default(cuid())
  patientId String   @map("patient_id")
  doctorId  String   @map("doctor_id")
  bookingId String?  @map("booking_id")
  date      DateTime @db.Date
  status    String
  price     Int      @default(0)
  diagnosis String   @default("")
  treatment String   @default("")
  notes     String   @default("")

  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor        Doctor         @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  booking       Booking?       @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  payments      Payment[]
  prescriptions Prescription[]

  @@index([patientId])
  @@index([doctorId])
  @@index([date])
  @@index([bookingId])
  @@map("visits")
}

model Payment {
  id          String   @id @default(cuid())
  patientId   String   @map("patient_id")
  amount      Int
  method      String
  status      String
  type        String   @default("INCOME") // INCOME (Kirim) or EXPENSE (Chiqim)
  date        DateTime @db.Date
  description String
  discount    Int?
  serviceId   String?  @map("service_id")
  visitId     String?  @map("visit_id")

  patient Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  visit   Visit?   @relation(fields: [visitId], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@index([status])
  @@index([date])
  @@index([type])
  @@index([visitId])
  @@map("payments")
}

model PatientComment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  patientId String   @map("patient_id")
  authorId  String   @map("author_id")

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@map("patient_comments")
}

model Notification {
  id        String   @id @default(cuid())
  patientId String?  @map("patient_id")
  doctorId  String?  @map("doctor_id")
  type      String
  message   String
  sentAt    DateTime @map("sent_at")
  status    String

  patient Patient? @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor  Doctor?  @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([doctorId])
  @@index([sentAt])
  @@map("notifications")
}

/// Outgoing Telegram message queue + delivery history (outbox).
/// status: pending (queued / waiting for retry) | sent | failed (gave up)
model NotificationLog {
  id            String    @id @default(cuid())
  channel       String    @default("telegram")
  /// lead_group | lead_status_group | patient_booking | patient_status | reminder ...
  kind          String
  chatId        String    @map("chat_id")
  text          String
  /// Telegram `reply_markup` (inline keyboard) as sent.
  replyMarkup   Json?     @map("reply_markup")
  status        String    @default("pending")
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at")
  lastError     String?   @map("last_error")
  leadId        String?   @map("lead_id")
  patientId     String?   @map("patient_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  sentAt        DateTime? @map("sent_at")

  @@index([status, nextAttemptAt])
  @@index([createdAt])
  @@map("notification_logs")
}

model Lead {
  id          String   @id @default(cuid())
  name        String
  phone       String
  service     String?
  message     String?
  status      String   @default("new") // new, contacted, consultation, proposal, converted, cancelled
  source      String   @default("telegram_bot")
  notes       String?
  /// Preferred doctor (free text from the website form).
  doctor      String?
  /// Preferred visit, "YYYY-MM-DD" or "YYYY-MM-DD HH:mm" (Asia/Tashkent).
  preferredAt String?  @map("preferred_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([createdAt])
  @@index([phone, createdAt])
  @@map("leads")
}

/// Single-row clinic settings (id is always 1).
model ClinicSettings {
  id                       Int      @id @default(1)
  clinicName               String   @default("Zahro Dental") @map("clinic_name")
  address                  String   @default("")
  phone                    String   @default("")
  workingHours             String   @default("") @map("working_hours")
  smsReminderTemplate      String   @map("sms_reminder_template")
  telegramReminderTemplate String   @map("telegram_reminder_template")
  reminderDaysAhead        Int      @default(1) @map("reminder_days_ahead")
  updatedAt                DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("clinic_settings")
}

/// Electronic prescription. The pharmacy finds it by `code` (or patient phone)
/// and marks it dispensed. status: issued | dispensed | cancelled
model Prescription {
  id          String    @id @default(cuid())
  code        String    @unique
  patientId   String    @map("patient_id")
  doctorId    String    @map("doctor_id")
  visitId     String?   @map("visit_id")
  status      String    @default("issued")
  notes       String    @default("")
  validUntil  DateTime  @map("valid_until") @db.Date
  createdAt   DateTime  @default(now()) @map("created_at")
  dispensedAt DateTime? @map("dispensed_at")
  dispensedBy String?   @map("dispensed_by")

  patient Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor  Doctor             @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  visit   Visit?             @relation(fields: [visitId], references: [id], onDelete: SetNull)
  items   PrescriptionItem[]

  @@index([patientId])
  @@index([doctorId])
  @@index([status])
  @@map("prescriptions")
}

model PrescriptionItem {
  id             String @id @default(cuid())
  prescriptionId String @map("prescription_id")
  name           String
  dosage         String @default("")
  frequency      String @default("")
  duration       String @default("")
  quantity       String @default("")
  instructions   String @default("")

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([prescriptionId])
  @@map("prescription_items")
}
