# ─────────────────────────────────────────────────────────────────────────────
# Zahro Dental API — LOKAL ISHLAB CHIQISH uchun namuna.
# Ishlatish:  cp .env.example .env   so'ng kerakli qiymatlarni o'zgartiring.
# (Production uchun .env.production.example faylini ko'ring.)
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
# Backend qaysi portda ishlaydi. Docker image'da 7878 qo'yilgan.
PORT=3000
# Qaysi tarmoq manzilida tinglaydi. 0.0.0.0 = barcha manzillardan (Docker uchun shart).
HOST=0.0.0.0
# Ish rejimi: development (lokal) yoki production (server). Production'da qat'iy
# tekshiruvlar yoqiladi (JWT_SECRET, CORS_ORIGINS, admin paroli majburiy).
NODE_ENV=development
# Vaqt zonasi. Eslatmalar va sanalar shu zona bo'yicha ishlaydi. O'zgartirmang.
TZ=Asia/Tashkent
# Frontend/admin panel manzillari (vergul bilan ajratiladi, oxirida "/" yo'q).
# Production'da MAJBURIY — bo'sh bo'lsa backend ishga tushmaydi. Socket.IO ham shuni ishlatadi.
# Lokalda bo'sh qoldirsangiz, hamma manzildan so'rov qabul qilinadi.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# Backend'ning tashqi (ochiq) manzili. Faqat startdagi log va Swagger havolalarida ko'rinadi.
PUBLIC_BASE_URL=http://localhost:3000
# Backend nginx yoki load balancer orqasida bo'lsa 1, to'g'ridan-to'g'ri bo'lsa 0.
# Foydalanuvchining haqiqiy IP'sini aniqlash (rate limit uchun) shunga bog'liq.
TRUST_PROXY=0
# Swagger (API hujjati) /swagger manzilida. Lokalda true, production'da false tavsiya.
SWAGGER_ENABLED=true
# Log ko'rinishi: text (odam o'qishi uchun) yoki json (log yig'uvchi tizimlar uchun).
# Bo'sh qoldirilsa: production'da json, aks holda text.
LOG_FORMAT=text

# ── Baza (Prisma / PostgreSQL) ───────────────────────────────────────────────
# Bazaga ulanish manzili. Format: postgresql://FOYDALANUVCHI:PAROL@HOST:PORT/BAZA?schema=public
# Lokal:  postgresql://postgres:postgres@localhost:5432/zahro_dental?schema=public
# Docker: HOST o'rniga docker-compose'dagi baza servisi nomi (masalan db) yoziladi.
# Paroldagi maxsus belgilar (@ / : kabi) URL-encode qilinishi kerak.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zahro_dental?schema=public

# ── Autentifikatsiya ─────────────────────────────────────────────────────────
# Tokenlarni imzolash uchun maxfiy kalit. Production'da MAJBURIY, kamida 32 belgi.
# Yaratish:  openssl rand -base64 48
# Diqqat: kalit almashsa, hamma foydalanuvchi tizimdan chiqib ketadi.
JWT_SECRET=dev-only-change-me-to-a-long-random-string
# Access token umri: 900 (soniya) | 30s | 15m | 1h | 7d. Odatda 15m.
JWT_EXPIRES_IN=15m
# Refresh token umri, kunlarda (1 dan 365 gacha). Odatda 30.
REFRESH_TOKEN_TTL_DAYS=30

# ── Birinchi admin (faqat tizimda admin yo'q bo'lganda, ishga tushganda yaratiladi) ──
# Admin telefon raqami (login shu). Xalqaro formatda, qo'shtirnoq ichida.
INITIAL_ADMIN_PHONE="+998901234567"
# Admin paroli. Production'da MAJBURIY: kamida 8 belgi va "admin123" bo'lmasligi kerak.
# Faqat birinchi adminni yaratishda ishlatiladi; keyin parolni panel ichidan almashtiring.
INITIAL_ADMIN_PASSWORD=admin12345
# Admin ismi (panelda ko'rinadi).
INITIAL_ADMIN_NAME="Admin"

# ── SMS (Eskiz.uz) ───────────────────────────────────────────────────────────
# Eskiz kabinetidagi login (email). Bo'sh bo'lsa SMS umuman yuborilmaydi:
# eslatmalar "failed" deb yoziladi va keyingi urinishda qayta yuboriladi.
ESKIZ_EMAIL=
# Eskiz kabinetidagi parol (yoki API uchun berilgan maxfiy kalit).
ESKIZ_PASSWORD=
# SMS yuboruvchi nomi/raqami (Eskiz'da tasdiqlangan bo'lishi shart). 4546 — umumiy raqam.
ESKIZ_FROM=4546
# Ixtiyoriy: Eskiz API manzili. Odatda o'zgartirish shart emas.
ESKIZ_BASE_URL=https://notify.eskiz.uz
# Ixtiyoriy: Eskiz javobini kutish vaqti, millisekundda (8000 = 8 soniya).
ESKIZ_HTTP_TIMEOUT_MS=8000

# ── Telegram bot (lidlar va bemorlarga eslatma; API jarayoni ichida ishlaydi) ─
# @BotFather bergan bot tokeni. Bo'sh bo'lsa bot o'chiq bo'ladi.
# Lokalda alohida TEST bot ishlating! Bitta tokenni ikki joyda ishlatsangiz,
# Telegram "409 Conflict" xatosini beradi va bot ishlamay qoladi.
TELEGRAM_BOT_TOKEN=
# Botni yoqish/o'chirish. Bir tokenni bir nechta server ishlatsa, bittasidan
# boshqalarida false qo'ying (aks holda 409 Conflict bo'ladi).
TELEGRAM_BOT_ENABLED=true
# Klinika xodimlari guruhining chat ID'si (manfiy son, masalan -1001234567890).
# Saytdan/botdan kelgan yangi lidlar shu guruhga tushadi. Bo'sh bo'lsa o'chiq.
# Guruhda FAQAT klinika xodimlari bo'lsin (bemor ismi va telefoni yuboriladi).
TELEGRAM_LEADS_CHAT_ID=
# Botning ochiq username'i, "@" belgisiz (masalan zahro_dental_bot).
# SMS ichidagi t.me/<username>?start=lead havolasi uchun kerak.
TELEGRAM_BOT_USERNAME=
# Ixtiyoriy: bron holati o'zgarishi va ko'chirish so'rovlari tushadigan guruh ID'si.
# Bo'sh bo'lsa TELEGRAM_LEADS_CHAT_ID ishlatiladi.
TELEGRAM_STATUS_CHAT_ID=
