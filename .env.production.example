# ─────────────────────────────────────────────────────────────────────────────
# Zahro Dental API — PRODUCTION template.
# On the server: /home/ubuntu/projects/zaxro_dent/backend/zahrodent_backend/.env
# (chmod 600, owner ubuntu). Never commit the real file.
# Replace every CHANGE_ME. Generate secrets with:  openssl rand -base64 48
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
# The Docker image sets PORT=7878 and TZ=Asia/Tashkent; keep them in sync.
PORT=7878
HOST=0.0.0.0
NODE_ENV=production
TZ=Asia/Tashkent
# REQUIRED — the server refuses to start without it. Admin panel origin(s).
CORS_ORIGINS=https://admin.CHANGE_ME.uz
PUBLIC_BASE_URL=https://api.CHANGE_ME.uz
# The API sits behind nginx → 1.
TRUST_PROXY=1
# Keep Swagger off in production unless you really need it.
SWAGGER_ENABLED=false
# JSON lines for log collectors (default in production anyway).
LOG_FORMAT=json

# ── Database ─────────────────────────────────────────────────────────────────
# Container on the zaxro_network Docker network → host is the container name.
# Password: openssl rand -base64 32 | tr -d '/+=' (URL-safe).
DATABASE_URL=postgresql://zahro:CHANGE_ME@zahro_db:5432/zahro_dental?schema=public

# ── Auth ─────────────────────────────────────────────────────────────────────
# REQUIRED, >= 32 chars:  openssl rand -base64 48
# Rotating it logs everybody out (access tokens become invalid).
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30

# ── Initial admin (only used when the users table has no admin) ──────────────
# REQUIRED on every boot in production (>= 8 chars, not "admin123") — the server
# refuses to start without it, even when an admin already exists. It is only
# used to create the first admin: change that admin's password after the first
# login (PATCH /auth/password); later edits here don't change existing users.
INITIAL_ADMIN_PHONE="+998CHANGE_ME"
INITIAL_ADMIN_PASSWORD=CHANGE_ME
INITIAL_ADMIN_NAME="Admin"

# ── SMS (Eskiz.uz) ───────────────────────────────────────────────────────────
ESKIZ_EMAIL=CHANGE_ME@example.com
ESKIZ_PASSWORD=CHANGE_ME
# Approved sender name / number in your Eskiz cabinet.
ESKIZ_FROM=4546
ESKIZ_BASE_URL=https://notify.eskiz.uz
ESKIZ_HTTP_TIMEOUT_MS=8000

# ── Telegram bot ─────────────────────────────────────────────────────────────
# From @BotFather. Exactly ONE running instance may poll with this token.
TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_BOT_ENABLED=true
